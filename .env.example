# ====================================
# DocMind Environment Configuration
# ====================================

# PostgreSQL & pgvector Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind_secret
POSTGRES_DB=docmind_db
DATABASE_URL=postgresql://docmind:docmind_secret@localhost:5432/docmind_db

# Local persistence root
DOCMIND_DATA_DIR=../data
DOCMIND_SOURCE_DIR=../data/knowledge
DOCMIND_SYNC_ON_STARTUP=false

# Local Qwen3-4B GGUF Configuration (download/cache this file before offline use)
DOCMIND_LLM_MODEL_PATH=./backend/models/qwen3-4b-instruct-q4_k_m.gguf
DOCMIND_LLM_CONTEXT_TOKENS=4096
DOCMIND_LLM_THREADS=4
DOCMIND_LLM_MAX_TOKENS=600
DOCMIND_MIN_SOURCE_SCORE=0.20
DOCMIND_LOG_LEVEL=INFO
DOCMIND_LOG_QUERIES=false

# Local Qwen3 embedding and optional BGE reranker directories
DOCMIND_EMBEDDING_MODEL_PATH=
DOCMIND_RERANKER_MODEL_PATH=

# Product configuration (the frontend reads these from GET /api/config/)
DOCMIND_CATEGORIES=General,HR,Tech,Finance,Legal,Operations
DOCMIND_DEFAULT_CATEGORY=General
DOCMIND_SUPPORTED_EXTENSIONS=.pdf,.docx,.pptx,.xlsx,.xls,.txt,.md
DOCMIND_MAX_FILE_SIZE_MB=50
DOCMIND_CHUNK_SIZE_CHARS=600
DOCMIND_CHUNK_OVERLAP_CHARS=100
DOCMIND_FAST_TOP_K=5
DOCMIND_QUALITY_FINAL_K=5
DOCMIND_QUALITY_CANDIDATE_K=30
DOCMIND_SUGGESTED_PROMPTS=What information is available in the indexed documents?|Summarize the most relevant evidence for my question.

# Frontend & Auth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=docmind-super-secret-key-change-in-production
BACKEND_URL=http://localhost:8000

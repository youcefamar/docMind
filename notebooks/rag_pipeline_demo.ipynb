   "source": [
    "# DocMind — Core RAG Pipeline (Week 1 Demo)\n",
    "\n",
    "Welcome to **DocMind** core RAG pipeline notebook! This notebook demonstrates step-by-step how to:\n",
    "1. Parse a PDF document page-by-page using `pypdf`\n",
    "2. Split text into overlapping chunks with page metadata\n",
    "3. Compute vector embeddings using `sentence-transformers` (`all-MiniLM-L6-v2`)\n",
    "4. Persist and query vector embeddings in **ChromaDB**\n",
    "5. Retrieve top matching chunks and prompt **Groq LLM** (`Llama 3.1 8B`) for a grounded answer with page citations."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 1: Install & Import Dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# %pip install pypdf sentence-transformers chromadb groq python-dotenv\n",
    "import os\n",
    "import io\n",
    "import pypdf\n",
    "import chromadb
    "from sentence_transformers import SentenceTransformer\n",
    "from groq import Groq\n",
    "\n",
    "print(\"Dependencies successfully imported!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 2: Load PDF & Extract Text Chunks"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def extract_chunks_from_pdf(pdf_path, category=\"HR\", chunk_size=500, overlap=100):\n",
    "    with open(pdf_path, \"rb\") as f:\n",
    "        reader = pypdf.PdfReader(f)\n",
    "        num_pages = len(reader.pages)\n",
    "        chunks = []\n",
    "        for idx, page in enumerate(reader.pages):\n",
    "            page_num = idx + 1\n",
    "            text = page.extract_text() or \"\"\n",
    "            cleaned = \" \".join([line.strip() for line in text.splitlines() if line.strip()])\n",
    "            \n",
    "            # Split text into chunks\n",
    "            start = 0\n",
    "            c_idx = 0\n",
    "            while start < len(cleaned):\n",
    "                end = start + chunk_size\n",
    "                chunk_str = cleaned[start:end]\n",
    "                chunks.append({\n",
    "                    \"id\": f\"doc1_p{page_num}_c{c_idx}\",\n",
    "                    \"text\": chunk_str,\n",
    "                    \"page\": page_num,\n",
    "                    \"category\": category,\n",
    "                    \"filename\": os.path.basename(pdf_path)\n",
    "                })\n",
    "                c_idx += 1\n",
    "                start = end - overlap if (end - overlap) > start else end\n",
    "    return chunks\n",
    "\n",
    "# Example usage:\n",
    "# chunks = extract_chunks_from_pdf(\"sample_policy.pdf\", category=\"HR\")\n",
    "# print(f\"Extracted {len(chunks)} chunks\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 3: Embed Chunks & Index in ChromaDB"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "embedding_model = SentenceTransformer(\"all-MiniLM-L6-v2\")\n",
    "chroma_client = chromadb.PersistentClient(path=\"../backend/db/chroma\")\n",
    "collection = chroma_client.get_or_create_collection(name=\"demo_kb\")\n",
    "\n",
    "def index_chunks(chunks):\n",
    "    texts = [c[\"text\"] for c in chunks]\n",
    "    embeddings = embedding_model.encode(texts).tolist()\n",
    "    ids = [c[\"id\"] for c in chunks]\n",
    "    metadatas = [{\"page\": c[\"page\"], \"filename\": c[\"filename\"], \"category\": c[\"category\"]} for c in chunks]\n",
    "    \n",
    "    collection.add(\n",
    "        ids=ids,\n",
    "        embeddings=embeddings,\n",
    "        documents=texts,\n",
    "        metadatas=metadatas\n",
    "    )\n",
    "    print(f\"Indexed {len(chunks)} chunks into ChromaDB!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 4: Query ChromaDB & Synthesize Answer with Groq (Llama 3.1 8B)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def ask_docmind(question, top_k=3):\n",
    "    q_emb = embedding_model.encode([question]).tolist()\n",
    "    results = collection.query(query_embeddings=q_emb, n_results=top_k)\n",
    "    \n",
    "    sources = []\n",
    "    context_lines = []\n",
    "    if results and results.get(\"documents\"):\n",
    "        docs = results[\"documents\"][0]\n",
    "        metas = results[\"metadatas\"][0]\n",
    "        for idx, (doc, meta) in enumerate(zip(docs, metas), 1):\n",
    "            context_lines.append(f\"Source [{idx}] ({meta['filename']} Page {meta['page']}):\\n{doc}\")\n",
    "            sources.append(meta)\n",
    "            \n",
    "    context_str = \"\\n\\n\".join(context_lines)\n",
    "    \n",
    "    api_key = os.getenv(\"GROQ_API_KEY\", \"\")\n",
    "    if not api_key:\n",
    "        return f\"Top matching context found:\\n\\n{context_str}\\n\\n(Set GROQ_API_KEY to generate LLM response)\"\n",
    "        \n",
    "    client = Groq(api_key=api_key)\n",
    "    prompt = f\"\"\"Context:\n{context_str}\n\nQuestion: {question}\n\nAnswer strictly based on the context above. Cite the source page number.\"\"\"\n",
    "    \n",
    "    resp = client.chat.completions.create(\n",
    "        model=\"llama-3.1-8b-instant\",\n",
    "        messages=[{\"role\": \"user\", \"content\": prompt}]\n",
    "    )\n",
    "    \n",
    "    return resp.choices[0].message.content\n",
    "\n",
    "# Test question:\n",
    "# answer = ask_docmind(\"What is the policy for annual leave?\")\n",
    "# print(answer)"
   ]
  }
